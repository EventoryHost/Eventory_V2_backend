{
  "name": "eventory_upload_service",
  "version": "1.0.0",
  "description": "Presigned S3 upload service for Eventory",
  "main": "server.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "sync-env:dev": "gh secret set UPLOAD_DEV_ENV < .env",
    "sync-env:prod": "gh secret set UPLOAD_PROD_ENV < .env.prod"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
