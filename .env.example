# =====================================================================
# Customer WhatsApp notifications (Interakt) — docs/whatsapp/README.md
# =====================================================================

# Master switch. Leave false until the credentials AND templates below are
# set and approved. While false nothing is sent and nothing is written.
WHATSAPP_NOTIFICATIONS_ENABLED=false

# ---- REQUIRED credentials (from the Interakt account admin) ----
# Interakt → Settings → Developer Settings → API key. Paste it exactly as
# shown (it is already encoded; it is sent as "Authorization: Basic <key>").
INTERAKT_API_KEY=
# The secret you type into Interakt → Developer Settings → Webhooks. Used to
# verify the Interakt-Signature header. Webhooks are refused without it.
INTERAKT_WEBHOOK_SECRET=

# ---- REQUIRED templates: the approved template's CODE NAME in Interakt ----
# (the part of the template's dashboard URL between "template/" and "/view").
# A type left empty is skipped on its own; the others still send.
# Copy and variable order for each: docs/whatsapp/TEMPLATES.md
WHATSAPP_TEMPLATE_WELCOME=
WHATSAPP_TEMPLATE_VENDOR_RESPONSE=
WHATSAPP_TEMPLATE_BOOKING_REQUEST=
WHATSAPP_TEMPLATE_BOOKING_STATUS=
WHATSAPP_TEMPLATE_BOOKING_MODIFICATION=
WHATSAPP_TEMPLATE_BOOKING_MODIFIED=
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=
WHATSAPP_TEMPLATE_PAYMENT_SUCCESS=
WHATSAPP_TEMPLATE_PAYMENT_FAILED=
WHATSAPP_TEMPLATE_PAYMENT_REMINDER=
WHATSAPP_TEMPLATE_REFUND_INITIATED=
WHATSAPP_TEMPLATE_REFUND_COMPLETED=
WHATSAPP_TEMPLATE_EVENT_REMINDER=
WHATSAPP_TEMPLATE_EVENT_DAY=

# ---- OPTIONAL settings (defaults shown) ----
# Language code the templates were approved in.
WHATSAPP_TEMPLATE_LANGUAGE=en
# Record messages without calling Interakt (staging checks).
WHATSAPP_DRY_RUN=false
# Comma-separated E.164 numbers; when set, ONLY these receive messages.
# Use on dev/staging databases that contain real customers.
WHATSAPP_RECIPIENT_ALLOWLIST=
# Country codes accepted for recipients.
WHATSAPP_ALLOWED_COUNTRY_CODES=+91
# Interakt API base URL (only change if Interakt tells you to).
INTERAKT_API_BASE_URL=https://api.interakt.ai/v1/public
WHATSAPP_API_TIMEOUT_MS=10000
# Attempts within one send, and in total incl. scheduler retries.
WHATSAPP_MAX_ATTEMPTS_INLINE=3
WHATSAPP_MAX_ATTEMPTS_TOTAL=6
WHATSAPP_RETRY_BASE_DELAY_MS=1000
# Per backend instance. Interakt allows 300/min (Growth) or 600/min (Advanced).
WHATSAPP_RATE_LIMIT_PER_MINUTE=240
# Scheduled reminders only go out between these IST hours (start-end).
WHATSAPP_SCHEDULE_WINDOW_IST=9-21
# Remind about an unpaid instalment this many hours before it is due.
WHATSAPP_PAYMENT_REMINDER_LEAD_HOURS=48
# Repeated proposal edits on one booking within this window send one message.
WHATSAPP_MODIFICATION_THROTTLE_MINUTES=30
